{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudOpsSecurityFindingsReadOnly",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:GetLogGroupFields",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:{region}:{account_id}:log-group:{findings_log_group_name}:*",
        "arn:aws:logs:{region}:{account_id}:log-group:{findings_log_group_name}/*:*"
      ]
    },
    {
      "Sid": "CloudOpsAccountLevelReadActions",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:StopQuery"
      ],
      "Resource": "*"
    }
  ]
}
